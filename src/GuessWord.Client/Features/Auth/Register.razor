@page "/register"
@inject GuessWord.Client.Infrastructure.Http.AuthService AuthService
@inject NavigationManager Navigation

<PageTitle>Регистрация</PageTitle>

<div class="auth-page">
    <form class="auth-card" @onsubmit="RegisterUser" @onsubmit:preventDefault="true">
        <h1 class="auth-title">Регистрация</h1>

        <div class="auth-field">
            <label class="auth-label" for="auth-name">Имя:</label>
            <input class="auth-input" id="auth-name" autocomplete="nickname" @bind="name" @bind:event="oninput" placeholder="Имя" />
        </div>

        <div class="auth-field">
            <label class="auth-label" for="auth-login">Логин:</label>
            <input class="auth-input" id="auth-login" autocomplete="username" @bind="login" @bind:event="oninput" placeholder="Логин" />
        </div>

        <div class="auth-field">
            <label class="auth-label" for="auth-password">Пароль:</label>
            <input class="auth-input" id="auth-password" autocomplete="new-password" type="password" @bind="password" @bind:event="oninput" placeholder="Пароль" />
        </div>

        <div class="auth-message" role="alert">@errorMessage</div>

        <button class="auth-button" type="submit">
            Зарегистрироваться
        </button>

        <div class="auth-footer-text">
            <span class="auth-footer-question">Уже есть аккаунт?</span>
            <a href="/login">Войти</a>
        </div>
    </form>
</div>

@code {
    private string name = string.Empty;
    private string login = string.Empty;
    private string password = string.Empty;
    private string errorMessage = string.Empty;

    private async Task RegisterUser()
    {
        if (string.IsNullOrWhiteSpace(name) ||
            string.IsNullOrWhiteSpace(login) ||
            string.IsNullOrWhiteSpace(password))
        {
            errorMessage = "Заполните все поля!";
            return;
        }

        errorMessage = string.Empty;

        var result = await AuthService.Register(new GuessWord.Contracts.Requests.RegisterRequestDto
        {
            Name = name,
            Login = login,
            Password = password
        });

        if (result is null)
        {
            errorMessage = "Не удалось зарегистрироваться.";
            return;
        }

        Navigation.NavigateTo("/");
    }
}
