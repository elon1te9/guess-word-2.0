@page "/login"
@inject GuessWord.Client.Infrastructure.Http.AuthService AuthService
@inject NavigationManager Navigation

<PageTitle>Вход</PageTitle>

<div class="auth-page">
    <form class="auth-card" @onsubmit="LoginUser" @onsubmit:preventDefault="true">
        <h1 class="auth-title">Авторизация</h1>

        <div class="auth-field">
            <label class="auth-label" for="auth-login">Логин:</label>
            <input class="auth-input" id="auth-login" autocomplete="username" @bind="login" @bind:event="oninput" placeholder="Логин" />
        </div>

        <div class="auth-field">
            <label class="auth-label" for="auth-password">Пароль:</label>
            <input class="auth-input" id="auth-password" autocomplete="current-password" type="password" @bind="password" @bind:event="oninput" placeholder="Пароль" />
        </div>

        <div class="auth-message" role="alert">@errorMessage</div>

        <button class="auth-button" type="submit">
            Войти
        </button>

        <div class="auth-footer-text">
            <span class="auth-footer-question">Еще нет аккаунта?</span>
            <a href="/register">Зарегистрироваться</a>
        </div>
    </form>
</div>

@code {
    private string login = string.Empty;
    private string password = string.Empty;
    private string errorMessage = string.Empty;

    private async Task LoginUser()
    {
        if (string.IsNullOrWhiteSpace(login) || string.IsNullOrWhiteSpace(password))
        {
            errorMessage = "Заполните все поля!";
            return;
        }

        errorMessage = string.Empty;

        var result = await AuthService.Login(new GuessWord.Contracts.Requests.LoginRequestDto
        {
            Login = login,
            Password = password
        });

        if (result is null)
        {
            errorMessage = "Неверный логин или пароль.";
            return;
        }

        Navigation.NavigateTo("/");
    }
}
